rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public editable review — honor-system coder attribution.
    // Papers collection: anyone can read; writes must carry last_edited_by.
    match /papers/{paperId} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasAll(['last_edited_by'])
                            && request.resource.data.last_edited_by is string
                            && request.resource.data.last_edited_by.size() > 0
                            && request.resource.data.last_edited_by.size() < 40;
      allow delete: if false;
    }
    // Coder log: append-only.
    match /papers/{paperId}/log/{entryId} {
      allow read: if true;
      allow create: if request.resource.data.coder is string
                    && request.resource.data.coder.size() > 0
                    && request.resource.data.change is string
                    && request.resource.data.change.size() < 2000;
      allow update, delete: if false;
    }
    // Coders roster — anyone can read; anyone can add themselves.
    // Coder id is the doc id; must be a short slug. Existing coders can update
    // their own display name/role but nobody can delete anyone.
    match /coders/{coderId} {
      allow read: if true;
      allow create, update: if coderId.matches('^[a-z0-9][a-z0-9_-]{0,39}$')
                            && request.resource.data.name is string
                            && request.resource.data.name.size() > 0
                            && request.resource.data.name.size() < 60;
      allow delete: if false;
    }
    // Everything else denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
